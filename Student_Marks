-- 5. INNER JOIN Query
-- Display all student details with subject name and marks

SELECT
    StudentMaster.StudentId,
    StudentMaster.StudentName,
    StudentMaster.Gender,
    StudentMaster.Age,
    StudentMaster.City,
    StudentMarks.SubjectName,
    StudentMarks.Marks
FROM StudentMaster
INNER JOIN StudentMarks
ON StudentMaster.StudentId = StudentMarks.StudentId;
